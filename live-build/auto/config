	--mirror-binary https://deb.debian.org/debian \
	--security false \
	--binary-images iso-hybrid \
	--debian-installer false \
	--iso-application GameXOSTR \
	--iso-publisher GameXOSTR \
	--iso-volume GAMEXOSTR \
	--memtest none